# Garmin Connect credentials
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password_here

# Encryption key for storing credentials in DB.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Database (default: SQLite in current directory)
DATABASE_URL=sqlite:///./garmin_training.db

# How many months of history to sync (default: 6)
SYNC_MONTHS=6

# Readiness score cache lifetime in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# Frontend CORS origin (default: http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000
